{
  "name": "jogo-da-soberana",
  "version": "0.876.0",
  "private": true,
  "type": "module",
  "description": "Jogo arcade brasileiro de defesa antiaérea para a Soberana Game Jam.",
  "scripts": {
    "predev": "node scripts/generate-russian-sfx.mjs && node scripts/generate-national-special-sfx.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-russian-sfx.mjs && node scripts/generate-national-special-sfx.mjs",
    "build": "vite build --base=./",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "build:itch": "npm run build && node scripts/build-itch.mjs && node scripts/build-itch-zip.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
